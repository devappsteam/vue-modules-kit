<script setup lang="ts">
import { computed, reactive, watch } from 'vue'

import { FileText, LoaderCircle } from '@lucide/vue'

import BaseModal from '@/components/ui/BaseModal.vue'

import type {
  {{MODULE_SINGULAR_PASCAL}},
  {{MODULE_SINGULAR_PASCAL}}CreatePayload,
  {{MODULE_SINGULAR_PASCAL}}UpdatePayload,
} from '../types/{{MODULE_NAME_KEBAB}}.types'

const props = withDefaults(
  defineProps<{
    open: boolean
    {{MODULE_SINGULAR_CAMEL}}?: {{MODULE_SINGULAR_PASCAL}} | null
    loading?: boolean
  }>(),
  {
    {{MODULE_SINGULAR_CAMEL}}: null,
    loading: false,
  },
)

const emit = defineEmits<{
  close: []
  submit: [
    data:
      | {{MODULE_SINGULAR_PASCAL}}CreatePayload
      | {{MODULE_SINGULAR_PASCAL}}UpdatePayload,
  ]
}>()

const isEditing = computed(() =>
  Boolean(props.{{MODULE_SINGULAR_CAMEL}}),
)

const form = reactive({
  name: '',
  description: '',
  is_active: true,
})

function resetForm() {
  form.name = props.{{MODULE_SINGULAR_CAMEL}}?.name ?? ''
  form.description =
    props.{{MODULE_SINGULAR_CAMEL}}?.description ?? ''
  form.is_active = props.{{MODULE_SINGULAR_CAMEL}}?.is_active ?? true
}

watch(
  () => props.open,
  (open) => {
    if (open) resetForm()
  },
)

function handleSubmit() {
  emit('submit', {
    name: form.name.trim(),
    description: form.description.trim() || null,
    is_active: form.is_active,
  })
}
</script>

<template>
  <BaseModal
    :open="props.open"
    :loading="props.loading"
    size="lg"
    @close="emit('close')"
  >
    <template #header>
      <div class="flex items-center gap-3">
        <div
          class="flex size-10 items-center justify-center rounded-lg bg-slate-100 text-slate-700"
        >
          <FileText class="size-5" aria-hidden="true" />
        </div>

        <div>
          <h2 class="text-base font-semibold text-slate-900">
            {{
              isEditing ? 'Editar' : 'Criar'
            }}
            {{MODULE_SINGULAR_TITLE}}
          </h2>
          <p class="mt-0.5 text-sm text-slate-500">
            Informe os dados do(a) {{MODULE_SINGULAR_CAMEL}}.
          </p>
        </div>
      </div>
    </template>

    <form
      id="{{MODULE_NAME_KEBAB}}-form"
      class="space-y-5 px-6 py-6"
      @submit.prevent="handleSubmit"
    >
      <div>
        <label
          for="{{MODULE_NAME_KEBAB}}-name"
          class="mb-1.5 block text-sm font-medium text-slate-700"
        >
          Nome
        </label>
        <input
          id="{{MODULE_NAME_KEBAB}}-name"
          v-model="form.name"
          type="text"
          required
          maxlength="255"
          :disabled="loading"
          class="h-10 w-full rounded-lg border border-slate-200 px-3 text-sm outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200 disabled:bg-slate-50"
        />
      </div>

      <div>
        <label
          for="{{MODULE_NAME_KEBAB}}-description"
          class="mb-1.5 block text-sm font-medium text-slate-700"
        >
          Descrição
          <span class="font-normal text-slate-400">(opcional)</span>
        </label>
        <textarea
          id="{{MODULE_NAME_KEBAB}}-description"
          v-model="form.description"
          rows="4"
          :disabled="loading"
          class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200 disabled:bg-slate-50"
        />
      </div>

      <label class="flex items-center gap-2 text-sm text-slate-700">
        <input
          v-model="form.is_active"
          type="checkbox"
          :disabled="loading"
          class="size-4 rounded border-slate-300"
        />
        Ativo
      </label>
    </form>

    <template #footer>
      <div class="flex justify-end gap-2">
        <button
          type="button"
          :disabled="loading"
          class="h-9 rounded-md border border-slate-200 bg-white px-4 text-sm font-medium text-slate-700 disabled:opacity-50"
          @click="emit('close')"
        >
          Cancelar
        </button>
        <button
          type="submit"
          form="{{MODULE_NAME_KEBAB}}-form"
          :disabled="loading"
          class="inline-flex h-9 items-center gap-2 rounded-md bg-slate-900 px-4 text-sm font-medium text-white disabled:opacity-50"
        >
          <LoaderCircle
            v-if="loading"
            class="size-4 animate-spin"
            aria-hidden="true"
          />
          {{ isEditing ? 'Salvar alterações' : 'Criar' }}
        </button>
      </div>
    </template>
  </BaseModal>
</template>
