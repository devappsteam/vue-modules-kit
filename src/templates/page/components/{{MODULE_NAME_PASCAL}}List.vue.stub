<script setup lang="ts">
import { computed, onBeforeUnmount, ref, watch } from 'vue'

import {
  FileText,
  LoaderCircle,
  Pencil,
  Plus,
  Search,
  Trash,
} from '@lucide/vue'

import type { PaginationMeta } from '@/types/api.types'

import type { {{MODULE_SINGULAR_PASCAL}} } from '../types/{{MODULE_NAME_KEBAB}}.types'

const props = withDefaults(
  defineProps<{
    {{MODULE_NAME_CAMEL}}: {{MODULE_SINGULAR_PASCAL}}[]
    pagination: PaginationMeta
    loading?: boolean
  }>(),
  { loading: false },
)

const emit = defineEmits<{
  create: []
  edit: [record: {{MODULE_SINGULAR_PASCAL}}]
  delete: [record: {{MODULE_SINGULAR_PASCAL}}]
  pageChange: [page: number]
  search: [value: string]
}>()

const search = ref('')
const isSearching = ref(false)
const hasRecords = computed(
  () => props.{{MODULE_NAME_CAMEL}}.length > 0,
)
const isInitialLoading = computed(() => props.loading && !hasRecords.value)
const emptyMessage = computed(() =>
  search.value
    ? 'Tente buscar utilizando outros termos.'
    : 'Crie o primeiro registro para começar.',
)

let searchTimeout: ReturnType<typeof setTimeout> | undefined

watch(search, (value) => {
  if (searchTimeout) clearTimeout(searchTimeout)
  isSearching.value = true
  searchTimeout = setTimeout(() => {
    emit('search', value.trim())
    isSearching.value = false
    searchTimeout = undefined
  }, 400)
})

onBeforeUnmount(() => {
  if (searchTimeout) clearTimeout(searchTimeout)
})

function formatDate(date: string) {
  return new Intl.DateTimeFormat('pt-BR', {
    dateStyle: 'short',
    timeStyle: 'short',
  }).format(new Date(date))
}
</script>

<template>
  <div class="space-y-5">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-slate-900">
          {{MODULE_PLURAL_TITLE}}
        </h2>
        <p class="mt-1 text-sm text-slate-500">
          Consulte, pesquise e gerencie os registros.
        </p>
      </div>

      <div class="flex flex-col gap-2 sm:flex-row">
        <div class="relative w-full sm:w-72">
          <LoaderCircle
            v-if="isSearching"
            class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 animate-spin text-slate-400"
            aria-hidden="true"
          />
          <Search
            v-else
            class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
            aria-hidden="true"
          />
          <input
            v-model="search"
            type="search"
            placeholder="Buscar..."
            aria-label="Buscar registros"
            class="h-9 w-full rounded-lg border border-slate-200 bg-white py-2 pl-9 pr-3 text-sm text-slate-700 outline-none placeholder:text-slate-400 focus:border-slate-400 focus:ring-2 focus:ring-slate-200"
          />
        </div>

        <button
          type="button"
          class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-md bg-slate-900 px-4 text-sm font-medium text-white transition hover:bg-slate-800"
          @click="emit('create')"
        >
          <Plus class="size-4" aria-hidden="true" />
          Criar {{MODULE_SINGULAR_TITLE}}
        </button>
      </div>
    </div>

    <div class="overflow-hidden rounded border border-slate-200 bg-white">
      <div class="overflow-x-auto">
        <table class="w-full min-w-180 text-sm">
          <thead class="border-b border-slate-200 bg-slate-50/80">
            <tr>
              <th
                class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
              >
                Nome
              </th>
              <th
                class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
              >
                Descrição
              </th>
              <th
                class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
              >
                Status
              </th>
              <th
                class="px-5 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
              >
                Criado em
              </th>
              <th
                class="w-24 px-5 py-3.5 text-right text-xs font-semibold uppercase tracking-wider text-slate-500"
              >
                Ações
              </th>
            </tr>
          </thead>

          <tbody v-if="isInitialLoading">
            <tr>
              <td
                colspan="5"
                class="px-5 py-14 text-center text-sm text-slate-500"
              >
                <span class="inline-flex items-center gap-2">
                  <LoaderCircle
                    class="size-4 animate-spin"
                    aria-hidden="true"
                  />
                  Carregando...
                </span>
              </td>
            </tr>
          </tbody>

          <tbody v-else-if="hasRecords" class="divide-y divide-slate-100">
            <tr
              v-for="record in {{MODULE_NAME_CAMEL}}"
              :key="record.uuid"
              class="transition-colors hover:bg-slate-50/70"
            >
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div
                    class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-slate-100 bg-slate-50"
                  >
                    <FileText
                      class="size-5 text-slate-400"
                      aria-hidden="true"
                    />
                  </div>
                  <span class="font-medium text-slate-800">{{
                    record.name
                  }}</span>
                </div>
              </td>
              <td class="max-w-sm truncate px-5 py-3.5 text-slate-600">
                {{ record.description || '—' }}
              </td>
              <td class="whitespace-nowrap px-5 py-3.5">
                <span
                  class="rounded-full px-2.5 py-1 text-xs font-medium"
                  :class="
                    record.is_active
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'bg-slate-100 text-slate-600'
                  "
                >
                  {{ record.is_active ? 'Ativo' : 'Inativo' }}
                </span>
              </td>
              <td class="whitespace-nowrap px-5 py-3.5 text-slate-500">
                {{ formatDate(record.created_at) }}
              </td>
              <td class="px-5 py-3.5">
                <div class="flex items-center justify-end gap-1">
                  <button
                    type="button"
                    :title="`Editar ${record.name}`"
                    class="inline-flex size-8 items-center justify-center rounded-md text-slate-400 hover:bg-slate-100 hover:text-slate-700"
                    @click="emit('edit', record)"
                  >
                    <Pencil class="size-4" aria-hidden="true" />
                    <span class="sr-only">Editar</span>
                  </button>
                  <button
                    type="button"
                    :title="`Excluir ${record.name}`"
                    class="inline-flex size-8 items-center justify-center rounded-md text-slate-400 hover:bg-rose-50 hover:text-rose-600"
                    @click="emit('delete', record)"
                  >
                    <Trash class="size-4" aria-hidden="true" />
                    <span class="sr-only">Excluir</span>
                  </button>
                </div>
              </td>
            </tr>
          </tbody>

          <tbody v-else>
            <tr>
              <td colspan="5" class="px-5 py-14 text-center">
                <div class="mx-auto flex max-w-sm flex-col items-center">
                  <FileText class="size-8 text-slate-400" aria-hidden="true" />
                  <p class="mt-3 font-medium text-slate-700">
                    Nenhum registro encontrado
                  </p>
                  <p class="mt-1 text-sm text-slate-500">{{ emptyMessage }}</p>
                  <button
                    v-if="!search"
                    type="button"
                    class="mt-4 inline-flex h-9 items-center gap-1.5 rounded-md bg-slate-900 px-4 text-sm font-medium text-white"
                    @click="emit('create')"
                  >
                    <Plus class="size-4" aria-hidden="true" />
                    Criar primeiro registro
                  </button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <Pagination
        :pagination="pagination"
        :loading="loading"
        label="registro"
        label-plural="registros"
        @page-change="emit('pageChange', $event)"
      />
    </div>
  </div>
</template>
