<script setup lang="ts">
import { computed, reactive, ref, watch } from 'vue'
import { LoaderCircle } from '@lucide/vue'
import { useRoute, useRouter } from 'vue-router'

import { useToast } from '@/composables/useToast'
import { getApiErrorMessage } from '@/utils/api-error'

import { use{{MODULE_NAME_PASCAL}}Store } from '../stores/{{MODULE_NAME_KEBAB}}.store'

import type {
  {{MODULE_SINGULAR_PASCAL}}CreatePayload,
  {{MODULE_SINGULAR_PASCAL}}UpdatePayload,
} from '../types/{{MODULE_NAME_KEBAB}}.types'

const route = useRoute()
const router = useRouter()
const {{MODULE_NAME_CAMEL}}Store =
  use{{MODULE_NAME_PASCAL}}Store()
const { addToast } = useToast()
const recordId = computed(() =>
  typeof route.params.uuid === 'string' ? route.params.uuid : '',
)
const isEditing = computed(() => Boolean(recordId.value))
const isLoadingRecord = ref(false)
const loading = computed(
  () => {{MODULE_NAME_CAMEL}}Store.saving || isLoadingRecord.value,
)

const form = reactive({
  name: '',
  description: '',
  is_active: true,
})

function resetForm() {
  form.name = ''
  form.description = ''
  form.is_active = true
}

watch(
  recordId,
  async (uuid, _previous, onCleanup) => {
    let active = true
    onCleanup(() => {
      active = false
    })

    resetForm()
    if (!uuid) {
      isLoadingRecord.value = false
      return
    }

    isLoadingRecord.value = true
    try {
      const record =
        await {{MODULE_NAME_CAMEL}}Store.find{{MODULE_SINGULAR_PASCAL}}(
          uuid,
        )
      if (!active) return

      form.name = record.name
      form.description = record.description ?? ''
      form.is_active = record.is_active
    } catch (error) {
      if (active) {
        addToast(
          getApiErrorMessage(error, 'Não foi possível carregar o registro.'),
          'error',
        )
      }
    } finally {
      if (active) isLoadingRecord.value = false
    }
  },
  { immediate: true },
)

async function handleSubmit() {
  const data:
    | {{MODULE_SINGULAR_PASCAL}}CreatePayload
    | {{MODULE_SINGULAR_PASCAL}}UpdatePayload = {
    name: form.name.trim(),
    description: form.description.trim() || null,
    is_active: form.is_active,
  }

  try {
    if (isEditing.value) {
      await {{MODULE_NAME_CAMEL}}Store.update{{MODULE_SINGULAR_PASCAL}}(
        recordId.value,
        data,
      )
    } else {
      await {{MODULE_NAME_CAMEL}}Store.create{{MODULE_SINGULAR_PASCAL}}(
        data,
      )
    }

    addToast(
      isEditing.value
        ? 'Alterações salvas com sucesso!'
        : 'Registro criado com sucesso!',
      'success',
    )
    await router.push({ name: '{{MODULE_NAME_KEBAB}}' })
  } catch (error) {
    addToast(
      getApiErrorMessage(error, 'Não foi possível salvar o registro.'),
      'error',
    )
  }
}

async function handleCancel() {
  await router.push({ name: '{{MODULE_NAME_KEBAB}}' })
}
</script>

<template>
  <div class="mx-auto max-w-3xl space-y-5">
    <header>
      <h1 class="text-xl font-semibold text-slate-900">
        {{ isEditing ? 'Editar' : 'Criar' }} {{MODULE_SINGULAR_TITLE}}
      </h1>
      <p class="mt-1 text-sm text-slate-500">Preencha os dados do registro.</p>
    </header>

    <form
      id="{{MODULE_NAME_KEBAB}}-form"
      class="space-y-5 rounded-lg border border-slate-200 bg-white p-6"
      @submit.prevent="handleSubmit"
    >
      <div>
        <label
          for="{{MODULE_NAME_KEBAB}}-name"
          class="mb-1.5 block text-sm font-medium text-slate-700"
        >
          Nome
        </label>
        <input
          id="{{MODULE_NAME_KEBAB}}-name"
          v-model="form.name"
          type="text"
          required
          maxlength="255"
          :disabled="loading"
          class="h-10 w-full rounded-lg border border-slate-200 px-3 text-sm outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200 disabled:bg-slate-50"
        />
      </div>

      <div>
        <label
          for="{{MODULE_NAME_KEBAB}}-description"
          class="mb-1.5 block text-sm font-medium text-slate-700"
        >
          Descrição
          <span class="font-normal text-slate-400">(opcional)</span>
        </label>
        <textarea
          id="{{MODULE_NAME_KEBAB}}-description"
          v-model="form.description"
          rows="4"
          :disabled="loading"
          class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200 disabled:bg-slate-50"
        />
      </div>

      <label class="flex items-center gap-2 text-sm text-slate-700">
        <input
          v-model="form.is_active"
          type="checkbox"
          :disabled="loading"
          class="size-4 rounded border-slate-300"
        />
        Ativo
      </label>
    </form>

    <div class="flex justify-end gap-2">
      <button
        type="button"
        :disabled="loading"
        class="h-9 rounded-md border border-slate-200 px-4 text-sm disabled:opacity-50"
        @click="handleCancel"
      >
        Cancelar
      </button>
      <button
        type="submit"
        form="{{MODULE_NAME_KEBAB}}-form"
        :disabled="loading"
        class="inline-flex h-9 items-center gap-2 rounded-md bg-slate-900 px-4 text-sm font-medium text-white disabled:opacity-50"
      >
        <LoaderCircle
          v-if="loading"
          class="size-4 animate-spin"
          aria-hidden="true"
        />
        {{ isEditing ? 'Salvar alterações' : 'Criar' }}
      </button>
    </div>
  </div>
</template>
