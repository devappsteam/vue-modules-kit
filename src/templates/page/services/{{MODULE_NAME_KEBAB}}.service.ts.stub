import api from '@/services/api.service'

import type {
  ApiCollection,
  ApiPaginatedCollection,
  ApiResource,
} from '@/types/api.types'

import type {
  {{MODULE_SINGULAR_PASCAL}},
  {{MODULE_SINGULAR_PASCAL}}CreatePayload,
  {{MODULE_SINGULAR_PASCAL}}Filters,
  {{MODULE_SINGULAR_PASCAL}}UpdatePayload,
} from '../types/{{MODULE_NAME_KEBAB}}.types'

export const {{MODULE_NAME_PASCAL}}Service = {
  async index(
    params: {{MODULE_SINGULAR_PASCAL}}Filters = {},
  ): Promise<ApiPaginatedCollection<{{MODULE_SINGULAR_PASCAL}}>> {
    const response = await api.get<
      ApiPaginatedCollection<{{MODULE_SINGULAR_PASCAL}}>
    >('/{{MODULE_NAME_KEBAB}}', { params })

    return response.data
  },

  async all(): Promise<ApiCollection<{{MODULE_SINGULAR_PASCAL}}>> {
    const response = await api.get<
      ApiCollection<{{MODULE_SINGULAR_PASCAL}}>
    >('/{{MODULE_NAME_KEBAB}}/all')

    return response.data
  },

  async show(
